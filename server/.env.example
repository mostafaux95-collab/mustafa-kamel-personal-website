NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://portfolio:portfolio_dev_password@localhost:5432/portfolio_cms?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-64-hex-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-64-hex-chars"
JWT_REFRESH_TTL_DAYS=30

COOKIE_SECRET="change-me-64-hex-chars"

CORS_ORIGIN="http://localhost:5173"

SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_FIRST_NAME="Admin"
SUPER_ADMIN_LAST_NAME="User"

MAIL_TRANSPORT="console"
MAIL_FROM="no-reply@example.com"

APP_URL="http://localhost:5173"

# Cloudflare R2 (S3-compatible) media storage — optional. Leave unset for
# local dev (uploads go to server/uploads/). Required in production on
# any host with ephemeral disk (Render, etc.) — see DEPLOYMENT.md.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="portfolio-media"
# R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
