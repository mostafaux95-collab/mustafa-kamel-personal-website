// Prisma schema — Phase 1 (foundation): auth, RBAC, audit/soft-delete conventions.
// See /Users/mostafa/.claude/plans/wondrous-leaping-nebula.md for the full rationale.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // Pinned explicitly: this project has no "type": "module" in package.json
  // (plain CommonJS), so auto-detection isn't reliable here.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  passwordHash String

  firstName String
  lastName  String
  role      Role   @default(VIEWER)

  isEmailVerified       Boolean   @default(false)
  emailVerifyToken      String?   @unique
  emailVerifyExpiresAt  DateTime?

  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  // 2FA-ready fields; the TOTP flow itself ships in a later phase.
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  refreshTokens RefreshToken[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@map("users")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique // e.g. "projects:write", "users:invite", "settings:manage"
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique // never store the raw token

  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Minimal key/value skeleton for Phase 1 (maintenance mode flag, token TTL
// overrides, email-from address, etc.) — expanded into typed settings in a
// later phase once the admin UI needs richer structure.
model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("site_settings")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

// Public contact-form submissions. Unlike the content models, there's no
// draft/published lifecycle — just an inbox read/unread state — and
// createdById/updatedById stay null on creation since the submitter is
// an anonymous site visitor, not an authenticated admin user.
model ContactMessage {
  id       String  @id @default(uuid())
  name     String
  email    String
  whatsapp String?
  message  String
  isRead   Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

// Phase 2: first content model, matching the existing frontend's
// src/data/projects.ts card shape (grid/listing surface). The deeper
// case-study narrative (chapters, gallery, impact) is a separate future
// model — mirrors how the current site already splits "projects" (cards)
// from "case studies" (long-form pages) as two distinct data sources.
model Project {
  id   String @id @default(uuid())
  slug String @unique

  // Bilingual: base column = English, *Ar = Arabic (nullable while
  // content is being translated). Convention set in Phase 1.
  title   String
  titleAr String?

  company String

  tagline   String
  taglineAr String?

  role   String
  roleAr String?

  category String
  year     String

  coverGradientFrom String
  coverGradientTo   String

  // Real uploads (media library) take priority over the gradient tile
  // above when present — gradient stays as the fallback for projects
  // that haven't had a cover image uploaded yet.
  thumbnailUrl   String?
  coverImageUrl  String?
  galleryUrls    String[] @default([])

  challenge   String
  challengeAr String?
  solution    String
  solutionAr  String?

  // [{ value: string, label: string, labelAr?: string }]
  metrics Json

  techStack String[] @default([])
  tags      String[] @default([])

  hasCaseStudy Boolean @default(false)

  // Live product / external link shown as "Project link" at the end of
  // the case study — opens in a new tab. Optional: not every project has
  // a public URL (client work under NDA, internal tools, etc.).
  projectUrl String?

  metaTitle          String?
  metaTitleAr        String?
  metaDescription    String?
  metaDescriptionAr  String?

  status    ContentStatus @default(DRAFT)
  featured  Boolean       @default(false)
  sortOrder Int           @default(0)
  views     Int           @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([status, sortOrder])
  @@map("projects")
}

model Testimonial {
  id String @id @default(uuid())

  quote   String
  quoteAr String?

  role   String
  roleAr String?

  company String

  // Monogram tile is the fallback; avatarUrl (media library upload)
  // takes priority when present — same real-image-over-placeholder
  // pattern as Project's thumbnailUrl/coverImageUrl.
  avatarInitial String?
  avatarBg      String?
  avatarFg      String?
  avatarUrl     String?

  status    ContentStatus @default(DRAFT)
  featured  Boolean       @default(false)
  sortOrder Int           @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([status, sortOrder])
  @@map("testimonials")
}

model Client {
  id String @id @default(uuid())

  name   String
  nameAr String?

  // Monogram tile fields are now optional fallbacks — logoUrl (media
  // library upload) takes priority when present.
  logoInitial String?
  logoBg      String?
  logoFg      String?
  logoUrl     String?

  website  String?
  category String?

  status    ContentStatus @default(DRAFT)
  featured  Boolean       @default(false)
  sortOrder Int           @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([status, sortOrder])
  @@map("clients")
}

model Service {
  id String @id @default(uuid())

  title   String
  titleAr String?
  body    String
  bodyAr  String?

  // lucide-react icon name (e.g. "PenLine") — resolved client-side.
  icon String?

  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([status, sortOrder])
  @@map("services")
}

model Skill {
  id String @id @default(uuid())

  name   String
  category String

  detail   String
  detailAr String?

  level Int?
  years Int?

  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([status, sortOrder])
  @@map("skills")
}

model Experience {
  id String @id @default(uuid())

  company String

  role   String
  roleAr String?

  period String

  location   String
  locationAr String?

  summary   String
  summaryAr String?

  highlights   String[] @default([])
  highlightsAr String[] @default([])

  logoInitial String?
  logoBg      String?
  logoFg      String?

  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([status, sortOrder])
  @@map("experiences")
}

// CV page: education history and language proficiency entries. Kept as
// separate small models (rather than folding into Experience or a
// generic settings blob) since each is its own add/edit/delete list.
model CvEducation {
  id String @id @default(uuid())

  degree   String
  degreeAr String?

  school   String
  schoolAr String?

  years String

  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([status, sortOrder])
  @@map("cv_education")
}

model CvLanguage {
  id String @id @default(uuid())

  name   String
  nameAr String?

  level   String
  levelAr String?

  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([status, sortOrder])
  @@map("cv_languages")
}

// CV page: certificate/credential images shown in an auto-playing
// slider. `isVisible` is a plain show/hide toggle rather than the
// DRAFT/PUBLISHED ContentStatus enum used elsewhere — certificates are
// simpler, binary content with no meaningful "draft" state. The
// metadata fields (title/issuer/date/verifyUrl) are optional and
// mostly unused today; they exist now so a future "show issuer/date on
// hover" feature needs no migration, just admin UI to fill them in.
model Certificate {
  id String @id @default(uuid())

  imageUrl String

  title   String?
  titleAr String?

  issuer   String?
  issuerAr String?

  issueDate String?
  verifyUrl String?

  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([isVisible, sortOrder])
  @@map("certificates")
}

// Local-disk media library (Phase 3 pulled forward). `url` is a path
// relative to the API's static /uploads mount (e.g. "/uploads/xxx.jpg"),
// not an absolute URL — callers build the full src by prefixing the API
// origin. Swapping to Cloudinary/S3 later only changes how `url` is
// produced, not how it's consumed.
model MediaAsset {
  id String @id @default(uuid())

  url          String
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?

  altText   String?
  altTextAr String?
  folder    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([folder])
  @@map("media_assets")
}
